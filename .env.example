# Environment Configuration
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=media_archiver
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_archiver?schema=public"
DOCKER_DATABASE_URL="postgresql://postgres:postgres@db:5432/media_archiver?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
DOCKER_REDIS_URL="redis://redis:6379"

# Storage
STORAGE_PATH="./storage"
DOCKER_STORAGE_PATH="/app/storage"

# JWT Authentication
JWT_SECRET=media_archiver_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Task Limits (TASK.txt Item 1)
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_TASKS_PER_USER=3
TASK_TIMEOUT_SECONDS=120
